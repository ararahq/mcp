{
  "name": "@ararahq/mcp",
  "version": "6.0.0",
  "description": "The official AraraHQ MCP server for WhatsApp broadcasts and campaigns: send, measure what came back, reply.",
  "main": "build/index.js",
  "bin": {
    "ararahq-mcp": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/build-ui.mjs",
    "typecheck": "tsc --noEmit && tsc -p src/ui/app/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "start": "node build/index.js",
    "build:ui": "node scripts/build-ui.mjs",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "dev": "tsx watch src/index.ts --stdio",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "whatsapp",
    "claude",
    "claude-code",
    "cursor",
    "windsurf",
    "chatgpt",
    "ararahq",
    "broadcast",
    "campaigns",
    "mcp-apps",
    "disparo",
    "ai-agent",
    "brazil"
  ],
  "homepage": "https://docs.ararahq.com/mcp-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ararahq/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ararahq/mcp/issues"
  },
  "author": "AraraHQ <devs@ararahq.com>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "axios": "^1.18.0",
    "dotenv": "^17.3.1",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "keytar": "^7.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.131.1"
  }
}
